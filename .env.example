# Copy to .env and adjust. Never commit .env.
#
# Nothing reads these yet: Serena has no code. The settings will be named with the code, prefixed SERENA_.
#
# The museums Serena serves, each with its CollectionSpace server (JSON, museum to URL), for example:
# SERENA_TENANTS={"pahma": "https://pahma.qa.collectionspace.org"}
SERENA_TENANTS=
#
# No password belongs here. Each museum's read-only service account is a secret in AWS Secrets Manager, and its
# password is never stored anywhere else or logged.
