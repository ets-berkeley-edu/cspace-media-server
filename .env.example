# Copy to .env and adjust. Never commit .env. Settings are read in backend/serena/config.py, prefixed SERENA_.
#
# The museums Serena serves, each with its CollectionSpace server (JSON, museum to URL, without /cspace-services).
# Each museum needs a file in backend/serena/museums/. For example:
# SERENA_TENANTS={"pahma": "https://pahma.qa.collectionspace.org"}
SERENA_TENANTS=
#
# Which environment this is (for example QA), shown in the admin app.
SERENA_ENV_LABEL=
# DEBUG, INFO, WARNING or ERROR
SERENA_LOG_LEVEL=INFO
SERENA_AWS_REGION=us-west-2
#
# Where the unavailable images are (CloudFront, without a signature): <base>/<tenant>/unavailable.svg. Empty: Serena
# serves them itself at /unavailable/<tenant>.svg (local development).
SERENA_UNAVAILABLE_BASE_URL=
#
# DynamoDB: every table is <prefix>-<name>. Locally, DynamoDB Local's address, and create the tables at start-up.
SERENA_TABLE_PREFIX=serena-local
# SERENA_DYNAMODB_ENDPOINT=http://localhost:8000
# SERENA_CREATE_TABLES=true
#
# No password belongs here. Each museum's read-only service account is a secret in AWS Secrets Manager, and its
# password is never stored anywhere else or logged.
#
# Each museum's S3 bucket (JSON), and locally the S3 stand-in's address.
SERENA_BUCKETS=
# SERENA_S3_ENDPOINT=http://localhost:5000
#
# The ETL API: each museum's Secrets Manager secret ID for its tokens (JSON, museum to secret ID). The tokens
# themselves are only in Secrets Manager. Locally, the Secrets Manager stand-in's address.
SERENA_ETL_TOKEN_SECRET_IDS=
# SERENA_SECRETSMANAGER_ENDPOINT=http://localhost:5000
# The largest Blob-to-Media file accepted, in MB, uncompressed
SERENA_UPLOAD_MAX_MB=500
#
# The worker (python -m serena.worker), in seconds: how often it looks for work, renews its claim on a step, and how
# old a claim may get before the step counts as interrupted.
SERENA_WORKER_POLL_SECONDS=5
SERENA_WORKER_HEARTBEAT_SECONDS=30
SERENA_WORKER_HEARTBEAT_STALE_SECONDS=300
#
# The watchdog, in the worker: how often it checks (seconds), and the SNS topic alerts are emailed through. Empty:
# alerts are recorded and logged, not emailed. Locally, the SNS stand-in's address.
SERENA_WATCHDOG_SECONDS=300
SERENA_ALERT_TOPIC_ARN=
# SERENA_SNS_ENDPOINT=http://localhost:5000
#
# Delivery: the CloudFront distribution's base URL (a file is <base>/<tenant>/objects/<sha256>) and the Secrets
# Manager secret ID of its signing key. Locally, without CloudFront, SERENA_LOCAL_CDN=true (needs DynamoDB Local).
SERENA_CDN_BASE_URL=
SERENA_CLOUDFRONT_KEY_SECRET_ID=
# SERENA_LOCAL_CDN=true
