{
  "components": {
    "schemas": {
      "Links": {
        "properties": {
          "check": {
            "title": "Check",
            "type": "string"
          },
          "self": {
            "title": "Self",
            "type": "string"
          },
          "servable_list": {
            "title": "Servable List",
            "type": "string"
          },
          "solr_load": {
            "title": "Solr Load",
            "type": "string"
          },
          "update": {
            "title": "Update",
            "type": "string"
          }
        },
        "required": [
          "self",
          "servable_list",
          "check",
          "solr_load",
          "update"
        ],
        "title": "Links",
        "type": "object"
      },
      "Ping": {
        "properties": {
          "museum": {
            "description": "The museum the token belongs to",
            "examples": [
              "pahma"
            ],
            "title": "Museum",
            "type": "string"
          }
        },
        "required": [
          "museum"
        ],
        "title": "Ping",
        "type": "object"
      },
      "Problem": {
        "description": "An error: `type` names its kind, `title` says what it is, `detail` what to do about it.",
        "properties": {
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RefreshOut": {
        "properties": {
          "check": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The servable list check's result: result (passed or failed), rows, added, removed, changed, previous_rows, threshold_percent, delta_percent, error_count, errors (the first 20, each with line, field and problem), warnings",
            "title": "Check"
          },
          "file_name": {
            "description": "The name to give the servable list",
            "examples": [
              "servable-list.pahma.2026-10-10.tsv"
            ],
            "title": "File Name",
            "type": "string"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          },
          "museum": {
            "examples": [
              "pahma"
            ],
            "title": "Museum",
            "type": "string"
          },
          "poll_interval_seconds": {
            "description": "How long to wait between polls; use this value, not a fixed one",
            "examples": [
              15
            ],
            "title": "Poll Interval Seconds",
            "type": "integer"
          },
          "reasons": {
            "description": "Why the refresh is in its state, when that needs saying",
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "refresh_date": {
            "description": "The Pacific date when the refresh started",
            "examples": [
              "2026-10-10"
            ],
            "title": "Refresh Date",
            "type": "string"
          },
          "refresh_id": {
            "examples": [
              "pahma-2026-10-10-1"
            ],
            "title": "Refresh Id",
            "type": "string"
          },
          "solr_load": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The load outcome the ETL reported",
            "title": "Solr Load"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "step_timeout_seconds": {
            "description": "How long a step may take before the ETL job carries on without Serena",
            "examples": [
              1800
            ],
            "title": "Step Timeout Seconds",
            "type": "integer"
          },
          "update": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The servability update's counts: deleted, written, unchanged",
            "title": "Update"
          },
          "upload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UploadInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "refresh_id",
          "museum",
          "refresh_date",
          "state",
          "file_name",
          "poll_interval_seconds",
          "step_timeout_seconds",
          "links"
        ],
        "title": "RefreshOut",
        "type": "object"
      },
      "SolrLoad": {
        "properties": {
          "outcome": {
            "description": "loaded, or fell_back to the previous day's data",
            "enum": [
              "loaded",
              "fell_back"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "rows": {
            "description": "Documents loaded into the public core",
            "minimum": 0.0,
            "title": "Rows",
            "type": "integer"
          }
        },
        "required": [
          "outcome",
          "rows"
        ],
        "title": "SolrLoad",
        "type": "object"
      },
      "State": {
        "enum": [
          "started",
          "received",
          "checking",
          "ready",
          "check_failed",
          "solr_loaded",
          "updating",
          "updated",
          "update_failed",
          "abandoned"
        ],
        "title": "State",
        "type": "string"
      },
      "UploadInfo": {
        "properties": {
          "bytes": {
            "description": "Size of the uncompressed servable list",
            "title": "Bytes",
            "type": "integer"
          },
          "rows": {
            "description": "Data rows, not counting the header",
            "title": "Rows",
            "type": "integer"
          },
          "sha256": {
            "description": "SHA-256 of the uncompressed servable list, as sent in X-Content-SHA256",
            "title": "Sha256",
            "type": "string"
          },
          "uploaded_at": {
            "title": "Uploaded At",
            "type": "string"
          }
        },
        "required": [
          "sha256",
          "rows",
          "bytes",
          "uploaded_at"
        ],
        "title": "UploadInfo",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "See docs/design.md, The ETL API and The daily sequence. Every call needs the museum's bearer token (`Authorization: Bearer <token>`). Errors are application/problem+json.",
    "summary": "How the daily Solr ETL job hands each servable list to Serena",
    "title": "Serena ETL API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/museums/{tenant}": {
      "get": {
        "description": "For troubleshooting. 404 if the museum has no updated refresh yet.",
        "operationId": "latest_updated_museums__tenant__get",
        "parameters": [
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or refresh"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "The museum's latest updated refresh"
      }
    },
    "/museums/{tenant}/refreshes": {
      "post": {
        "description": "Serena assigns the refresh ID and the refresh date (the Pacific date now). If the museum's refresh for today\nis still open, returns it (200). An earlier refresh date's open refresh is closed as abandoned, unless Serena is\nchecking or updating it: then 409, and the ETL job tries again (decided October 9, 2026, D30).",
        "operationId": "start_refresh_museums__tenant__refreshes_post",
        "parameters": [
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshOut"
                }
              }
            },
            "description": "The museum's open refresh for today, returned instead of a new one"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or refresh"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The call is out of order for the refresh's state"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "Start today's refresh"
      }
    },
    "/museums/{tenant}/refreshes/{refresh_id}": {
      "get": {
        "operationId": "get_refresh_museums__tenant__refreshes__refresh_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "refresh_id",
            "required": true,
            "schema": {
              "title": "Refresh Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or refresh"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "The refresh's status"
      }
    },
    "/museums/{tenant}/refreshes/{refresh_id}/check": {
      "post": {
        "description": "Queues the servable list check (202); poll the refresh until it is ready or check_failed. Allowed once a\nservable list is uploaded (received), and again after a failed check: with a corrected list, or with the same\nlist when the ETL job is rerun after an admin overrode the delta threshold for it.",
        "operationId": "request_check_museums__tenant__refreshes__refresh_id__check_post",
        "parameters": [
          {
            "in": "path",
            "name": "refresh_id",
            "required": true,
            "schema": {
              "title": "Refresh Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshOut"
                }
              }
            },
            "description": "The servable list check is already done; the refresh is returned as it is"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or refresh"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The call is out of order for the refresh's state"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "Check the servable list without changing anything"
      }
    },
    "/museums/{tenant}/refreshes/{refresh_id}/servable-list": {
      "put": {
        "description": "Streams the servable list to Serena. Uploading the same list again changes nothing; a corrected list\nreplaces the previous one until the load's outcome is reported, and must then be checked again. Its format is\nchecked by the servable list check.",
        "operationId": "put_servable_list_museums__tenant__refreshes__refresh_id__servable_list_put",
        "parameters": [
          {
            "in": "path",
            "name": "refresh_id",
            "required": true,
            "schema": {
              "title": "Refresh Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          },
          {
            "description": "text/tab-separated-values",
            "in": "header",
            "name": "content-type",
            "required": true,
            "schema": {
              "description": "text/tab-separated-values",
              "title": "Content-Type",
              "type": "string"
            }
          },
          {
            "description": "Data rows, not counting the header",
            "in": "header",
            "name": "x-row-count",
            "required": true,
            "schema": {
              "description": "Data rows, not counting the header",
              "minimum": 0,
              "title": "X-Row-Count",
              "type": "integer"
            }
          },
          {
            "description": "Hex SHA-256 of the uncompressed servable list",
            "in": "header",
            "name": "x-content-sha256",
            "required": true,
            "schema": {
              "description": "Hex SHA-256 of the uncompressed servable list",
              "title": "X-Content-Sha256",
              "type": "string"
            }
          },
          {
            "description": "gzip, or absent",
            "in": "header",
            "name": "content-encoding",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "gzip, or absent",
              "title": "Content-Encoding"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/tab-separated-values": {
              "example": "blob_csid\tmedia_csid\tkind\taccess\n",
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A header or parameter is missing or malformed"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or refresh"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The call is out of order for the refresh's state"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The servable list is larger than Serena accepts"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The file isn't sent as text/tab-separated-values"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The file doesn't match its row count or SHA-256"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "Upload the servable list"
      }
    },
    "/museums/{tenant}/refreshes/{refresh_id}/solr-load": {
      "post": {
        "description": "Allowed once the servable list check passed (ready). loaded: the refresh waits for the servability update\n(solr_loaded). fell_back: the refresh is abandoned and Serena changes nothing, so both keep yesterday's data.",
        "operationId": "report_solr_load_museums__tenant__refreshes__refresh_id__solr_load_post",
        "parameters": [
          {
            "in": "path",
            "name": "refresh_id",
            "required": true,
            "schema": {
              "title": "Refresh Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolrLoad"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A header or parameter is missing or malformed"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or refresh"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The call is out of order for the refresh's state"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "Report the public core's load"
      }
    },
    "/museums/{tenant}/refreshes/{refresh_id}/update": {
      "post": {
        "description": "Queues the servability update (202); poll the refresh until it is updated or update_failed. Allowed only\nafter the servable list check passed and the load reported loaded (solr_loaded). Report the ETL job a success\nonly once the refresh is updated.",
        "operationId": "request_update_museums__tenant__refreshes__refresh_id__update_post",
        "parameters": [
          {
            "in": "path",
            "name": "refresh_id",
            "required": true,
            "schema": {
              "title": "Refresh Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
