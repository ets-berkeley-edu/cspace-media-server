{
  "components": {
    "schemas": {
      "Links": {
        "properties": {
          "apply": {
            "title": "Apply",
            "type": "string"
          },
          "blob_media": {
            "title": "Blob Media",
            "type": "string"
          },
          "preflight": {
            "title": "Preflight",
            "type": "string"
          },
          "self": {
            "title": "Self",
            "type": "string"
          },
          "solr_load": {
            "title": "Solr Load",
            "type": "string"
          }
        },
        "required": [
          "self",
          "blob_media",
          "preflight",
          "solr_load",
          "apply"
        ],
        "title": "Links",
        "type": "object"
      },
      "Ping": {
        "properties": {
          "museum": {
            "description": "The museum the token belongs to",
            "examples": [
              "pahma"
            ],
            "title": "Museum",
            "type": "string"
          }
        },
        "required": [
          "museum"
        ],
        "title": "Ping",
        "type": "object"
      },
      "Problem": {
        "description": "An error: `type` names its kind, `title` says what it is, `detail` what to do about it.",
        "properties": {
          "detail": {
            "default": "",
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RunOut": {
        "properties": {
          "apply": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The apply's counts: deleted, written, unchanged",
            "title": "Apply"
          },
          "file_name": {
            "description": "The name to give the Blob-to-Media file",
            "examples": [
              "blob-media.pahma.2026-10-10.tsv"
            ],
            "title": "File Name",
            "type": "string"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          },
          "museum": {
            "examples": [
              "pahma"
            ],
            "title": "Museum",
            "type": "string"
          },
          "night": {
            "description": "The Pacific date when the run started",
            "examples": [
              "2026-10-10"
            ],
            "title": "Night",
            "type": "string"
          },
          "poll_interval_seconds": {
            "description": "How long to wait between polls; use this value, not a fixed one",
            "examples": [
              15
            ],
            "title": "Poll Interval Seconds",
            "type": "integer"
          },
          "preflight": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The preflight's result: result (passed or failed), rows, added, removed, changed, previous_rows, threshold_percent, change_percent, error_count, errors (the first 20, each with line, field and problem), warnings",
            "title": "Preflight"
          },
          "reasons": {
            "description": "Why the run is in its state, when that needs saying",
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "run_id": {
            "examples": [
              "pahma-2026-10-10-1"
            ],
            "title": "Run Id",
            "type": "string"
          },
          "solr_load": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "The load outcome the ETL reported",
            "title": "Solr Load"
          },
          "state": {
            "$ref": "#/components/schemas/State"
          },
          "step_timeout_seconds": {
            "description": "How long a step may take before the ETL carries on without Serena",
            "examples": [
              1800
            ],
            "title": "Step Timeout Seconds",
            "type": "integer"
          },
          "upload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UploadInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "run_id",
          "museum",
          "night",
          "state",
          "file_name",
          "poll_interval_seconds",
          "step_timeout_seconds",
          "links"
        ],
        "title": "RunOut",
        "type": "object"
      },
      "SolrLoad": {
        "properties": {
          "outcome": {
            "description": "loaded, or fell_back to the previous night's data",
            "enum": [
              "loaded",
              "fell_back"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "rows": {
            "description": "Documents loaded into the public core",
            "minimum": 0.0,
            "title": "Rows",
            "type": "integer"
          }
        },
        "required": [
          "outcome",
          "rows"
        ],
        "title": "SolrLoad",
        "type": "object"
      },
      "State": {
        "enum": [
          "started",
          "received",
          "preflighting",
          "ready",
          "preflight_failed",
          "solr_loaded",
          "applying",
          "applied",
          "apply_failed",
          "abandoned"
        ],
        "title": "State",
        "type": "string"
      },
      "UploadInfo": {
        "properties": {
          "bytes": {
            "description": "Size of the uncompressed file",
            "title": "Bytes",
            "type": "integer"
          },
          "rows": {
            "description": "Data rows, not counting the header",
            "title": "Rows",
            "type": "integer"
          },
          "sha256": {
            "description": "SHA-256 of the uncompressed file, as sent in X-Content-SHA256",
            "title": "Sha256",
            "type": "string"
          },
          "uploaded_at": {
            "title": "Uploaded At",
            "type": "string"
          }
        },
        "required": [
          "sha256",
          "rows",
          "bytes",
          "uploaded_at"
        ],
        "title": "UploadInfo",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "See docs/design.md, The ETL API and The nightly sequence. Every call needs the museum's bearer token (`Authorization: Bearer <token>`). Errors are application/problem+json.",
    "summary": "How the nightly Solr ETL hands each night's Blob-to-Media file to Serena",
    "title": "Serena ETL API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/museums/{tenant}": {
      "get": {
        "description": "For troubleshooting. 404 if the museum has no applied run yet.",
        "operationId": "latest_applied_museums__tenant__get",
        "parameters": [
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or run"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "The museum's latest applied run"
      }
    },
    "/museums/{tenant}/runs": {
      "post": {
        "description": "Serena assigns the run ID and the night (the Pacific date now). If the museum's run for tonight is still\nopen, returns it (200). An earlier night's open run is closed as abandoned, unless Serena is preflighting or\napplying it: then 409, and the ETL tries again (decided October 9, 2026, D30).",
        "operationId": "start_run_museums__tenant__runs_post",
        "parameters": [
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "The museum's open run for tonight, returned instead of a new one"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or run"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The call is out of order for the run's state"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "Start tonight's run"
      }
    },
    "/museums/{tenant}/runs/{run_id}": {
      "get": {
        "operationId": "get_run_museums__tenant__runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or run"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "The run's status"
      }
    },
    "/museums/{tenant}/runs/{run_id}/apply": {
      "post": {
        "description": "Queues the apply (202); poll the run until it is applied or apply_failed. Allowed only after the\npreflight passed and the load reported loaded (solr_loaded). Report the night a success only once the run\nis applied.",
        "operationId": "request_apply_museums__tenant__runs__run_id__apply_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "The file is already applied; the run is returned as it is"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or run"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The call is out of order for the run's state"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "Apply the file"
      }
    },
    "/museums/{tenant}/runs/{run_id}/blob-media": {
      "put": {
        "description": "Streams the file to Serena. Uploading the same file again changes nothing; a corrected file replaces the\nprevious one until the load's outcome is reported, and must then be preflighted again. The file's format is\nchecked by the preflight.",
        "operationId": "put_blob_media_museums__tenant__runs__run_id__blob_media_put",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          },
          {
            "description": "text/tab-separated-values",
            "in": "header",
            "name": "content-type",
            "required": true,
            "schema": {
              "description": "text/tab-separated-values",
              "title": "Content-Type",
              "type": "string"
            }
          },
          {
            "description": "Data rows, not counting the header",
            "in": "header",
            "name": "x-row-count",
            "required": true,
            "schema": {
              "description": "Data rows, not counting the header",
              "minimum": 0,
              "title": "X-Row-Count",
              "type": "integer"
            }
          },
          {
            "description": "Hex SHA-256 of the uncompressed file",
            "in": "header",
            "name": "x-content-sha256",
            "required": true,
            "schema": {
              "description": "Hex SHA-256 of the uncompressed file",
              "title": "X-Content-Sha256",
              "type": "string"
            }
          },
          {
            "description": "gzip, or absent",
            "in": "header",
            "name": "content-encoding",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "gzip, or absent",
              "title": "Content-Encoding"
            }
          }
        ],
        "requestBody": {
          "content": {
            "text/tab-separated-values": {
              "example": "blob_csid\tmedia_csid\tkind\taccess\n",
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A header or parameter is missing or malformed"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or run"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The call is out of order for the run's state"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The file is larger than Serena accepts"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The file isn't sent as text/tab-separated-values"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The file doesn't match its row count or SHA-256"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "Upload the night's Blob-to-Media file"
      }
    },
    "/museums/{tenant}/runs/{run_id}/preflight": {
      "post": {
        "description": "Queues the preflight (202); poll the run until it is ready or preflight_failed. Allowed once a file is\nuploaded (received). A failed preflight needs a corrected file, which puts the run back in received.",
        "operationId": "request_preflight_museums__tenant__runs__run_id__preflight_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "The preflight is already done; the run is returned as it is"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No token, or a token Serena doesn't know"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The token is for another museum"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No such museum or run"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The call is out of order for the run's state"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Serena can't check right now (tokens or storage unavailable); try again"
          }
        },
        "summary": "Check the uploaded file without applying it"
      }
    },
    "/museums/{tenant}/runs/{run_id}/solr-load": {
      "post": {
        "description": "Allowed once the preflight passed (ready). loaded: the run waits for the apply (solr_loaded). fell_back:\nthe run is abandoned and Serena applies nothing, so both keep yesterday's data.",
        "operationId": "report_solr_load_museums__tenant__runs__run_id__solr_load_post",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "title": "Tenant",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolrLoad"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
