#!/usr/bin/env bash
# ./serena — Serena's local stack (design: Local development).
#
#   ./serena up                    build and start it: http://localhost:8300, the admin app http://localhost:5373/admin/
#   ./serena down                  stop it; moto forgets everything
#   ./serena status                what's running
#   ./serena logs [service]        follow the logs (services: web, worker, admin, fakecspace, moto, seed)
#   ./serena logs --no-follow [service]   print them and stop, for grep
#   ./serena etl <museum> [opts]   a daily refresh through the ETL API with the fake ETL (--failed, --rows N, --json)
#                                  (--file-only prints the servable list instead, for the admin app's upload page)
#   ./serena smoke                 a whole daily refresh for PAHMA, then fetch and serve one of its images (what CI runs)
#   ./serena ui [pytest options]   the admin app's Selenium tests (serenade/), in headless Chrome; --headed shows it
#   ./serena test [pytest options] the headless test suite (serenade/) on its own stack, started afresh, with its dataset
#   ./serena test-down             stop the test stack
#   ./serena urls                  the addresses
#
# The stack is its own Docker Compose project (serena), on ports that don't clash with the BMU's. It needs Docker
# and nothing else: no .env, no keys. It never talks to AWS or a real CollectionSpace.
set -euo pipefail
cd "$(dirname "$0")"

PORT="${SERENA_PORT:-8300}"
compose() { docker compose -p serena "$@"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  up)
    # Which code this stack runs, shown in the admin app's header and below: the clone's branch and commit.
    SERENA_BUILD="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown) @ $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    [ -z "$(git status --porcelain 2>/dev/null)" ] || SERENA_BUILD="$SERENA_BUILD + local changes"
    export SERENA_BUILD
    echo "Building from $SERENA_BUILD"
    compose up -d --build
    printf 'Waiting for http://localhost:%s/health ' "$PORT"
    for _ in $(seq 1 90); do
      if curl -fs -o /dev/null "http://localhost:$PORT/health"; then echo; break; fi
      printf '.'; sleep 2
    done
    curl -fs -o /dev/null "http://localhost:$PORT/health" || { echo; echo "Not up: ./serena logs web" >&2; exit 1; }
    # The worker starts once the app is healthy (it creates the tables); give it a moment.
    for _ in $(seq 1 30); do [ -n "$(compose ps -q --status running worker)" ] && break; sleep 1; done
    echo "Serena (Local · simulator, $SERENA_BUILD) is up: http://localhost:$PORT/health"
    echo "A daily refresh: ./serena etl pahma" ;;
  down)
    compose down ;;
  status)
    compose ps ;;
  logs)
    if [ "${1:-}" = --no-follow ]; then shift; compose logs --no-log-prefix "$@"; else compose logs -f --tail 100 "$@"; fi ;;
  etl)
    museum="${1:?Usage: ./serena etl <museum> [--failed] [--rows N] [--json] [--file-only]}"; shift
    compose exec -T worker python -m devtools.fake_etl --museum "$museum" --public "http://localhost:$PORT" "$@" ;;
  smoke)
    # The default --rows, like ./serena etl pahma, so a refresh before this one doesn't trip the servable list check's delta threshold.
    summary="$(compose exec -T worker python -m devtools.fake_etl --museum pahma --json)"
    state="$(printf '%s' "$summary" | python3 -c 'import json,sys; print(json.load(sys.stdin)["state"])')"
    if [ "$state" != updated ]; then
      echo "The refresh ended $state, not updated: $summary" >&2
      case "$summary" in
        *threshold*) echo "PAHMA's last updated refresh had a different --rows. Start afresh: ./serena down && ./serena up" >&2 ;;
      esac
      exit 1
    fi
    path="$(printf '%s' "$summary" | python3 -c 'import json,sys; print(json.load(sys.stdin)["samples"]["image"])')"
    location="$(curl -fsS -o /dev/null -w '%{redirect_url}' "http://localhost:$PORT$path")"
    case "$location" in
      *"/local-cdn/pahma/objects/"*) ;;
      *) echo "Expected a redirect to the stored image, got: $location" >&2; exit 1 ;;
    esac
    curl -fsS -o /dev/null "$location"
    echo "Smoke test passed: a refresh updated, and $path fetched, stored and served." ;;
  test)
    # The suite's own stack (Docker Compose project serena-test, its own ports), so a run never touches the stack
    # testers use by hand. Started afresh each run, so every run begins from the same data (serenade/dataset.py); left
    # running afterwards, to look at what a failed test saw. serenade/README.md explains the suite.
    export SERENA_PORT=8400 SERENA_ADMIN_PORT=5473 SERENA_SIM_PORT=8480 SERENA_MOTO_PORT=9400
    tcompose() { docker compose -p serena-test "$@"; }
    py="$(command -v python3.11 || true)"
    [ -n "$py" ] || { echo "./serena test needs python3.11 (the repository's Python)." >&2; exit 1; }
    if [ ! -x serenade/.venv/bin/python ]; then
      "$py" -m venv serenade/.venv
      serenade/.venv/bin/pip install -q --require-hashes -r serenade/requirements.txt
    fi
    SERENA_BUILD="test · $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown) @ $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    export SERENA_BUILD
    echo "Starting the test stack afresh ($SERENA_BUILD)"
    tcompose down >/dev/null 2>&1 || true
    tcompose up -d --build
    printf 'Waiting for Serena '
    for _ in $(seq 1 90); do curl -fs -o /dev/null "http://localhost:8400/health" && break; printf '.'; sleep 2; done
    curl -fs -o /dev/null "http://localhost:8400/health" || { echo; echo "Not up: docker compose -p serena-test logs web" >&2; exit 1; }
    for _ in $(seq 1 30); do [ -n "$(tcompose ps -q --status running worker)" ] && break; sleep 1; done
    printf '\nWaiting for the admin app (it installs its packages first) '
    for _ in $(seq 1 120); do curl -fs -o /dev/null "http://localhost:5473/admin/" && break; printf '.'; sleep 2; done
    curl -fs -o /dev/null "http://localhost:5473/admin/" || { echo; echo "Not up: docker compose -p serena-test logs admin" >&2; exit 1; }
    echo
    echo "Building the dataset: a daily refresh for PAHMA"
    mkdir -p serenade/.run
    tcompose exec -T worker python -m devtools.fake_etl --museum pahma --json > serenade/.run/dataset.json
    rm -rf serenade/.run/failures
    SERENADE_STACK=test SERENADE_DATASET=serenade/.run/dataset.json SERENADE_BASE_URL="http://localhost:5473/admin/" \
      SERENADE_SERENA_URL="http://localhost:8400" SERENADE_SIM_URL="http://localhost:8480" \
      serenade/.venv/bin/python -m pytest serenade -p no:cacheprovider "$@" || status=$?
    echo "The test stack is still running (./serena test-down stops it). Failed tests' screenshots: serenade/.run/failures/"
    exit "${status:-0}" ;;
  test-down)
    docker compose -p serena-test down ;;
  ui)
    # Python 3.11 (.python-version), the version serenade/requirements.txt is pinned for.
    py="$(command -v python3.11 || true)"
    [ -n "$py" ] || { echo "./serena ui needs python3.11 (the repository's Python)." >&2; exit 1; }
    if [ ! -x serenade/.venv/bin/python ]; then
      "$py" -m venv serenade/.venv
      serenade/.venv/bin/pip install -q --require-hashes -r serenade/requirements.txt
    fi
    curl -fs -o /dev/null "http://localhost:${SERENA_ADMIN_PORT:-5373}/admin/" ||
      { echo "The admin app isn't up: ./serena up (it can take a minute after that, for npm ci)." >&2; exit 1; }
    SERENADE_BASE_URL="http://localhost:${SERENA_ADMIN_PORT:-5373}/admin/" serenade/.venv/bin/python -m pytest serenade "$@" ;;
  urls)
    echo "Serena:      http://localhost:$PORT   (health: /health; files: /<museum>/imageserver/blobs/...)"
    echo "Admin app:   http://localhost:${SERENA_ADMIN_PORT:-5373}/admin/   (admin/admin, pahma-admin/pahma-admin, viewer/viewer)"
    echo "Simulator:   http://localhost:${SERENA_SIM_PORT:-8380}   (calls it received: /_fake/calls)"
    echo "moto:        http://localhost:${SERENA_MOTO_PORT:-9300}/moto-api/" ;;
  help|-h|--help)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Unknown command '$cmd'. ./serena help lists them." >&2; exit 2 ;;
esac
