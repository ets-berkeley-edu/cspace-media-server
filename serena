#!/usr/bin/env bash
# ./serena — Serena's local stack (design: Local development).
#
#   ./serena up                    build and start it: http://localhost:8300, the admin app http://localhost:5373/admin/
#   ./serena down                  stop it; moto forgets everything
#   ./serena status                what's running
#   ./serena logs [service]        follow the logs (services: web, worker, admin, fakecspace, moto, seed)
#   ./serena etl <museum> [opts]   run a night through the ETL API with the fake ETL (--partial, --rows N, --json)
#   ./serena smoke                 a whole night for PAHMA, then fetch and serve one of its images (what CI runs)
#   ./serena ui [pytest options]   the admin app's Selenium tests (serenade/), in headless Chrome; --headed shows it
#   ./serena urls                  the addresses
#
# The stack is its own Docker Compose project (serena), on ports that don't clash with the BMU's. It needs Docker
# and nothing else: no .env, no keys. It never talks to AWS or a real CollectionSpace.
set -euo pipefail
cd "$(dirname "$0")"

PORT="${SERENA_PORT:-8300}"
compose() { docker compose -p serena "$@"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  up)
    compose up -d --build
    printf 'Waiting for http://localhost:%s/health ' "$PORT"
    for _ in $(seq 1 90); do
      if curl -fs -o /dev/null "http://localhost:$PORT/health"; then echo; break; fi
      printf '.'; sleep 2
    done
    curl -fs -o /dev/null "http://localhost:$PORT/health" || { echo; echo "Not up: ./serena logs web" >&2; exit 1; }
    # The worker starts once the app is healthy (it creates the tables); give it a moment.
    for _ in $(seq 1 30); do [ -n "$(compose ps -q --status running worker)" ] && break; sleep 1; done
    echo "Serena (Local · simulator) is up: http://localhost:$PORT/health"
    echo "Run a night: ./serena etl pahma" ;;
  down)
    compose down ;;
  status)
    compose ps ;;
  logs)
    compose logs -f --tail 100 "$@" ;;
  etl)
    museum="${1:?Usage: ./serena etl <museum> [--partial] [--rows N] [--json]}"; shift
    compose exec -T worker python -m devtools.fake_etl --museum "$museum" --public "http://localhost:$PORT" "$@" ;;
  smoke)
    # The default --rows, like ./serena etl pahma, so a night run before this one doesn't trip preflight's threshold.
    summary="$(compose exec -T worker python -m devtools.fake_etl --museum pahma --json)"
    state="$(printf '%s' "$summary" | python3 -c 'import json,sys; print(json.load(sys.stdin)["state"])')"
    if [ "$state" != applied ]; then
      echo "The night ended $state, not applied: $summary" >&2
      case "$summary" in
        *threshold*) echo "PAHMA's last applied night had a different --rows. Start afresh: ./serena down && ./serena up" >&2 ;;
      esac
      exit 1
    fi
    path="$(printf '%s' "$summary" | python3 -c 'import json,sys; print(json.load(sys.stdin)["samples"]["image"])')"
    location="$(curl -fsS -o /dev/null -w '%{redirect_url}' "http://localhost:$PORT$path")"
    case "$location" in
      *"/local-cdn/pahma/objects/"*) ;;
      *) echo "Expected a redirect to the stored image, got: $location" >&2; exit 1 ;;
    esac
    curl -fsS -o /dev/null "$location"
    echo "Smoke test passed: a night applied, and $path fetched, stored and served." ;;
  ui)
    # Python 3.11 (.python-version), the version serenade/requirements.txt is pinned for.
    py="$(command -v python3.11 || true)"
    [ -n "$py" ] || { echo "./serena ui needs python3.11 (the repository's Python)." >&2; exit 1; }
    if [ ! -x serenade/.venv/bin/python ]; then
      "$py" -m venv serenade/.venv
      serenade/.venv/bin/pip install -q --require-hashes -r serenade/requirements.txt
    fi
    curl -fs -o /dev/null "http://localhost:${SERENA_ADMIN_PORT:-5373}/admin/" ||
      { echo "The admin app isn't up: ./serena up (it can take a minute after that, for npm ci)." >&2; exit 1; }
    SERENADE_BASE_URL="http://localhost:${SERENA_ADMIN_PORT:-5373}/admin/" serenade/.venv/bin/python -m pytest serenade "$@" ;;
  urls)
    echo "Serena:      http://localhost:$PORT   (health: /health; files: /<museum>/imageserver/blobs/...)"
    echo "Admin app:   http://localhost:${SERENA_ADMIN_PORT:-5373}/admin/   (admin/admin, pahma-admin/pahma-admin, viewer/viewer)"
    echo "Simulator:   http://localhost:${SERENA_SIM_PORT:-8380}   (calls it received: /_fake/calls)"
    echo "moto:        http://localhost:${SERENA_MOTO_PORT:-9300}/moto-api/" ;;
  help|-h|--help)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "Unknown command '$cmd'. ./serena help lists them." >&2; exit 2 ;;
esac
